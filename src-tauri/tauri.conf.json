{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "发票报销",
  "version": "0.2.3",
  "identifier": "com.invoice-desk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "发票报销",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: invoice-file:; frame-src 'self' data: invoice-file:; connect-src 'self' ipc: http://ipc.localhost invoice-file:; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/invoice-ocr"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
